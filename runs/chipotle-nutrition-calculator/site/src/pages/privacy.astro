---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy - Chipotle Nutrition Calculator" description="Privacy policy for the independent Chipotle Nutrition Calculator." canonicalPath="/privacy/">
  <main class="text-page">
    <h1>Privacy Policy</h1>
    <p>Chipotle Nutrition Calculator is a static browser-based tool. The calculator runs locally in your browser and does not require an account, login, database, or meal upload.</p>
    <p>We do not ask for your name, email address, health profile, or payment information. Meal selections are calculated in your current browser session.</p>
    <p>The production site may use Cloudflare Web Analytics to understand aggregate page usage. Cloudflare Web Analytics is configured without tracking cookies.</p>
    <p>This site is an independent informational tool and is not affiliated with Chipotle Mexican Grill, Inc.</p>
  </main>
</BaseLayout>
