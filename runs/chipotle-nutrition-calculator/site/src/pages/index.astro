---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Chipotle Nutrition Calculator: Calories, Macros, Sodium';
const description = 'Build a Chipotle-style bowl, burrito, salad, tacos, quesadilla, or side order and estimate calories, protein, carbs, fat, sodium, fiber, sugar, and saturated fat.';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://chipotlenutritioncalculator.app';

const faq = [
  {
    question: 'Is this the official Chipotle nutrition calculator?',
    answer: 'No. This is an independent nutrition estimator that uses published menu nutrition data for planning custom orders.',
  },
  {
    question: 'How accurate are the results?',
    answer: 'The calculator estimates standard published portions. Actual restaurant servings can vary by location, season, recipe update, and how a meal is prepared.',
  },
  {
    question: 'Can I calculate light or extra portions?',
    answer: 'Yes. Selected ingredients can be adjusted to light, normal, extra, or double portions.',
  },
  {
    question: 'What adds the most calories?',
    answer: 'The burrito tortilla, chips, guacamole, queso, cheese, sour cream, and vinaigrette can raise totals quickly.',
  },
  {
    question: 'Does this calculator store my meal?',
    answer: 'No. The calculator runs in your browser and does not require login, upload your order, or store personal meal history.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Chipotle Nutrition Calculator',
    url: siteUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="food-app">
    <section class="calculator-board" aria-labelledby="page-title">
      <div class="doodle leaf-one" aria-hidden="true"></div>
      <div class="doodle leaf-two" aria-hidden="true"></div>

      <header class="board-header">
        <div class="brand-mark" aria-hidden="true"></div>
        <div class="header-copy">
          <p class="eyebrow">Independent meal estimator</p>
          <h1 id="page-title">Chipotle<span class="mobile-title-break"><br /></span> Nutrition Calculator</h1>
          <p>Build your meal, see your nutrition, make choices you'll feel good about.</p>
        </div>
        <div class="header-actions" aria-label="Meal actions">
          <button type="button" class="clear-action" id="clear-all">Clear all</button>
          <button type="button" class="text-action" id="share-meal">Share meal</button>
        </div>
      </header>

      <section class="nutrition-ribbon" aria-label="Live meal totals" aria-live="polite">
        <div class="ribbon-cell featured">
          <i aria-hidden="true">♨</i>
          <span>Calories</span>
          <strong id="total-calories">0</strong>
          <em>kcal</em>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">◔</i>
          <span>Protein</span>
          <strong id="total-protein">0g</strong>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">♧</i>
          <span>Carbs</span>
          <strong id="total-carbs">0g</strong>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">◌</i>
          <span>Fat</span>
          <strong id="total-fat">0g</strong>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">▥</i>
          <span>Sodium</span>
          <strong id="total-sodium">0mg</strong>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">♮</i>
          <span>Fiber</span>
          <strong id="total-fiber">0g</strong>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">✣</i>
          <span>Sugar</span>
          <strong id="total-sugar">0g</strong>
        </div>
        <div class="ribbon-cell">
          <i aria-hidden="true">♡</i>
          <span>Sat fat</span>
          <strong id="total-sat-fat">0g</strong>
        </div>
      </section>

      <section class="meal-step" aria-labelledby="meal-format-title">
        <div class="step-title">
          <span>1.</span>
          <div>
            <h2 id="meal-format-title">Choose your meal</h2>
          </div>
        </div>
        <div class="format-grid" id="format-grid"></div>
      </section>

      <section class="builder-zone" aria-labelledby="builder-title">
        <div class="builder-heading">
          <div class="step-title">
            <span>2.</span>
            <div>
              <h2 id="builder-title">Build your meal</h2>
            </div>
          </div>
          <button type="button" class="portion-guide" id="portion-guide">Portion size guide</button>
        </div>
        <div class="ingredient-groups" id="ingredient-groups"></div>
      </section>

      <section class="preset-strip" aria-labelledby="presets-title">
        <div class="strip-title">
          <h2 id="presets-title">Quick presets</h2>
          <p>Popular builds to get you started.</p>
        </div>
        <div class="preset-list" id="preset-list"></div>
      </section>

      <section class="compare-strip" aria-labelledby="compare-title">
        <div class="section-kicker">
          <h2 id="compare-title">Compare your choices</h2>
          <p>Small changes can move the numbers fast.</p>
        </div>
        <div class="compare-grid">
          <article>
            <img src="/ui-assets/compare-bowl.png" alt="" loading="lazy" />
            <span>Bowl vs burrito</span>
            <strong id="compare-burrito">+320 cal</strong>
            <p>Same fillings, flour tortilla added.</p>
          </article>
          <article>
            <img src="/ui-assets/compare-rice.png" alt="" loading="lazy" />
            <span>Normal vs extra rice</span>
            <strong>+105 cal</strong>
            <p>Extra rice is roughly half a serving more.</p>
          </article>
          <article>
            <img src="/ui-assets/compare-chips.png" alt="" loading="lazy" />
            <span>With vs without chips</span>
            <strong>+540 cal</strong>
            <p>Chips can outweigh many lean toppings.</p>
          </article>
        </div>
      </section>

      <section class="summary-dock" aria-label="Current meal summary">
        <div>
          <span>Total</span>
          <strong><b id="dock-calories">0</b> cal</strong>
        </div>
        <p id="selected-summary">Bowl: no ingredients selected yet.</p>
        <button type="button" id="dock-copy" class="dock-button">Copy / Share Meal Summary</button>
      </section>

      <section class="source-band" aria-labelledby="source-title">
        <div class="illustration-note" aria-hidden="true"></div>
        <div>
          <h2 id="source-title">Source & accuracy</h2>
          <p>Nutrition estimates use published US menu nutrition data and standard portions. Values vary by location, availability, recipe changes, and how a meal is prepared.</p>
        </div>
        <p class="source-hand">Good choices.<br />Real results.</p>
      </section>

      <nav class="mobile-tabbar" aria-label="Mobile calculator sections">
        <a href="#presets-title">Presets</a>
        <a class="active" href="#builder-title">Build</a>
        <a href="#compare-title">Compare</a>
        <a href="#source-title">About</a>
      </nav>
    </section>

    <section class="content-band" aria-labelledby="how-it-works">
      <div class="content-grid">
        <article>
          <p class="eyebrow">Method</p>
          <h2 id="how-it-works">How the calculator works</h2>
          <p>The calculator adds published nutrition values for each selected format, ingredient, side, and drink. Portion buttons multiply each selected item so you can estimate light, normal, extra, or double servings without opening a spreadsheet.</p>
        </article>
        <article>
          <p class="eyebrow">Ordering reality</p>
          <h2>Bowl vs burrito calories</h2>
          <p>A bowl starts with no shell. A burrito starts with a flour tortilla, which adds calories, carbohydrates, and sodium before rice, beans, protein, salsa, or toppings.</p>
        </article>
        <article>
          <p class="eyebrow">Macro planning</p>
          <h2>High-protein and lower-calorie levers</h2>
          <p>Chicken, steak, beans, fajita vegetables, salsa, and greens are useful planning levers. Cheese, sour cream, queso, guacamole, chips, and vinaigrette are easy to underestimate.</p>
        </article>
        <article>
          <p class="eyebrow">Accuracy note</p>
          <h2>Why results are estimates</h2>
          <p>Published nutrition data uses standard portions. Actual servings can vary by store, staff, ingredient source, recipe changes, and whether you ask for light, extra, or double portions.</p>
        </article>
      </div>
    </section>

    <section class="nutrition-table-section" aria-labelledby="ingredient-table-title">
      <div class="section-title-row">
        <div>
          <p class="eyebrow">Reference</p>
          <h2 id="ingredient-table-title">Common ingredient calories</h2>
        </div>
        <p>Use the calculator above for full macros, sodium, fiber, sugar, and portion multipliers.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Portion</th>
              <th>Calories</th>
              <th>Protein</th>
              <th>Carbs</th>
              <th>Fat</th>
            </tr>
          </thead>
          <tbody id="reference-table"></tbody>
        </table>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Chipotle nutrition calculator questions</h2>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <footer class="site-footer">
      <p>This independent tool is not affiliated with Chipotle Mexican Grill, Inc. Nutrition estimates are for planning and general information only, not medical advice.</p>
      <nav aria-label="Footer">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/sitemap.xml">Sitemap</a>
      </nav>
    </footer>
  </main>

  <script is:inline>
    const formats = [
      { id: "bowl", name: "Bowl", image: "/ui-assets/format-bowl.png", note: "No shell", calories: 0, protein: 0, carbs: 0, fat: 0, sodium: 0, fiber: 0, sugar: 0, saturatedFat: 0 },
      { id: "burrito", name: "Burrito", image: "/ui-assets/format-burrito.png", note: "Flour tortilla", calories: 320, protein: 8, carbs: 50, fat: 9, sodium: 600, fiber: 3, sugar: 0, saturatedFat: 0.5 },
      { id: "salad", name: "Salad", image: "/ui-assets/format-salad.png", note: "Supergreens", calories: 15, protein: 1, carbs: 3, fat: 0, sodium: 20, fiber: 2, sugar: 1, saturatedFat: 0 },
      { id: "tacos", name: "Tacos", image: "/ui-assets/format-tacos.png", note: "3 crispy shells", calories: 210, protein: 3, carbs: 30, fat: 9, sodium: 0, fiber: 3, sugar: 0, saturatedFat: 0 },
      { id: "quesadilla", name: "Quesadilla", image: "/ui-assets/format-quesadilla.png", note: "Tortilla + cheese", calories: 430, protein: 14, carbs: 51, fat: 17, sodium: 790, fiber: 3, sugar: 1, saturatedFat: 8.5 }
    ];

    const items = [
      { id: "white-rice", group: "Rice", icon: "🍚", name: "White rice", portion: "4 oz", calories: 210, protein: 4, carbs: 40, fat: 4, sodium: 350, fiber: 1, sugar: 0, saturatedFat: 1 },
      { id: "brown-rice", group: "Rice", icon: "🌾", name: "Brown rice", portion: "4 oz", calories: 210, protein: 4, carbs: 36, fat: 6, sodium: 190, fiber: 2, sugar: 0, saturatedFat: 0 },
      { id: "cauli-rice", group: "Rice", icon: "✺", name: "Cauliflower rice", portion: "4 oz", calories: 40, protein: 3, carbs: 7, fat: 1, sodium: 210, fiber: 3, sugar: 2, saturatedFat: 0 },
      { id: "no-rice", group: "Rice", icon: "○", name: "No rice", portion: "0 oz", calories: 0, protein: 0, carbs: 0, fat: 0, sodium: 0, fiber: 0, sugar: 0, saturatedFat: 0 },
      { id: "black-beans", group: "Beans", icon: "⚫", name: "Black beans", portion: "4 oz", calories: 130, protein: 8, carbs: 22, fat: 1.5, sodium: 210, fiber: 7, sugar: 2, saturatedFat: 0 },
      { id: "pinto-beans", group: "Beans", icon: "🫘", name: "Pinto beans", portion: "4 oz", calories: 130, protein: 8, carbs: 21, fat: 1.5, sodium: 210, fiber: 8, sugar: 1, saturatedFat: 0 },
      { id: "no-beans", group: "Beans", icon: "○", name: "No beans", portion: "0 oz", calories: 0, protein: 0, carbs: 0, fat: 0, sodium: 0, fiber: 0, sugar: 0, saturatedFat: 0 },
      { id: "chicken", group: "Protein", icon: "🍗", name: "Chicken", portion: "4 oz", calories: 180, protein: 32, carbs: 0, fat: 7, sodium: 310, fiber: 0, sugar: 0, saturatedFat: 3 },
      { id: "steak", group: "Protein", icon: "🥩", name: "Steak", portion: "4 oz", calories: 150, protein: 21, carbs: 1, fat: 6, sodium: 330, fiber: 1, sugar: 0, saturatedFat: 2.5 },
      { id: "barbacoa", group: "Protein", icon: "🍖", name: "Barbacoa", portion: "4 oz", calories: 170, protein: 24, carbs: 2, fat: 7, sodium: 530, fiber: 1, sugar: 0, saturatedFat: 2.5 },
      { id: "carnitas", group: "Protein", icon: "♨", name: "Carnitas", portion: "4 oz", calories: 210, protein: 23, carbs: 0, fat: 12, sodium: 450, fiber: 0, sugar: 0, saturatedFat: 7 },
      { id: "sofritas", group: "Protein", icon: "◒", name: "Sofritas", portion: "4 oz", calories: 150, protein: 8, carbs: 9, fat: 10, sodium: 560, fiber: 3, sugar: 5, saturatedFat: 1.5 },
      { id: "no-protein", group: "Protein", icon: "○", name: "No protein", portion: "0 oz", calories: 0, protein: 0, carbs: 0, fat: 0, sodium: 0, fiber: 0, sugar: 0, saturatedFat: 0 },
      { id: "fresh-salsa", group: "Salsa", icon: "🍅", name: "Fresh tomato salsa", portion: "4 oz", calories: 25, protein: 0, carbs: 4, fat: 0, sodium: 550, fiber: 1, sugar: 1, saturatedFat: 0 },
      { id: "corn-salsa", group: "Salsa", icon: "🌽", name: "Roasted chili-corn salsa", portion: "4 oz", calories: 80, protein: 3, carbs: 16, fat: 1.5, sodium: 330, fiber: 3, sugar: 4, saturatedFat: 0 },
      { id: "green-salsa", group: "Salsa", icon: "🫑", name: "Tomatillo-green chili salsa", portion: "2 fl oz", calories: 15, protein: 0, carbs: 4, fat: 0, sodium: 260, fiber: 0, sugar: 2, saturatedFat: 0 },
      { id: "red-salsa", group: "Salsa", icon: "🌶", name: "Tomatillo-red chili salsa", portion: "2 fl oz", calories: 30, protein: 0, carbs: 4, fat: 0, sodium: 500, fiber: 1, sugar: 0, saturatedFat: 0 },
      { id: "fajita", group: "Toppings", icon: "🫑", name: "Fajita vegetables", portion: "2 oz", calories: 20, protein: 1, carbs: 5, fat: 0, sodium: 150, fiber: 1, sugar: 2, saturatedFat: 0 },
      { id: "lettuce", group: "Toppings", icon: "🥬", name: "Romaine lettuce", portion: "1 oz", calories: 5, protein: 0, carbs: 1, fat: 0, sodium: 0, fiber: 1, sugar: 0, saturatedFat: 0 },
      { id: "cheese", group: "Toppings", icon: "🧀", name: "Cheese", portion: "1 oz", calories: 110, protein: 6, carbs: 1, fat: 8, sodium: 190, fiber: 0, sugar: 0, saturatedFat: 5 },
      { id: "sour-cream", group: "Toppings", icon: "◌", name: "Sour cream", portion: "2 oz", calories: 110, protein: 2, carbs: 2, fat: 9, sodium: 30, fiber: 0, sugar: 1, saturatedFat: 7 },
      { id: "queso", group: "Toppings", icon: "◍", name: "Queso blanco", portion: "2 oz", calories: 120, protein: 5, carbs: 4, fat: 9, sodium: 540, fiber: 0, sugar: 2, saturatedFat: 6 },
      { id: "guac", group: "Sides", icon: "🥑", name: "Guacamole", portion: "4 oz", calories: 230, protein: 2, carbs: 8, fat: 22, sodium: 370, fiber: 6, sugar: 1, saturatedFat: 3.5 },
      { id: "chips", group: "Sides", icon: "▱", name: "Chips", portion: "4 oz", calories: 540, protein: 7, carbs: 73, fat: 25, sodium: 390, fiber: 7, sugar: 1, saturatedFat: 3.5 },
      { id: "chips-guac", group: "Sides", icon: "▰", name: "Chips + guac", portion: "1 order", calories: 770, protein: 9, carbs: 81, fat: 47, sodium: 760, fiber: 13, sugar: 2, saturatedFat: 7 },
      { id: "side-tortilla", group: "Sides", icon: "◔", name: "Side tortilla", portion: "1 tortilla", calories: 320, protein: 8, carbs: 50, fat: 9, sodium: 600, fiber: 3, sugar: 0, saturatedFat: 0.5 }
    ];

    const presets = [
      { name: "Lean Chicken Bowl", note: "480 cal · 40g protein", image: "/ui-assets/preset-bowl.png", format: "bowl", items: { chicken: 1, "brown-rice": 0.5, "black-beans": 0.5, fajita: 1, "fresh-salsa": 1, lettuce: 1 } },
      { name: "High Protein Double Chicken", note: "790 cal · 73g protein", image: "/ui-assets/preset-chicken.png", format: "bowl", items: { chicken: 2, "white-rice": 1, "black-beans": 1, fajita: 1, "red-salsa": 1 } },
      { name: "Lower Carb Steak Salad", note: "520 cal · 44g protein", image: "/ui-assets/preset-salad.png", format: "salad", items: { steak: 1, fajita: 1, "green-salsa": 1, cheese: 1, guac: 0.5 } },
      { name: "Veggie Bowl", note: "520 cal · 18g protein", image: "/ui-assets/preset-veggie.png", format: "bowl", items: { "brown-rice": 1, "black-beans": 1, fajita: 1, "corn-salsa": 1, "fresh-salsa": 1, guac: 1 } },
      { name: "Burrito Reality Check", note: "970 cal · 42g protein", image: "/ui-assets/preset-burrito.png", format: "burrito", items: { chicken: 1, "white-rice": 1, "pinto-beans": 1, cheese: 1, "sour-cream": 1, "fresh-salsa": 1 } },
      { name: "Chips + Guac", note: "770 cal · side impact", image: "/ui-assets/preset-chips.png", format: "bowl", items: { "chips-guac": 1 } }
    ];

    const groupOrder = ["Rice", "Beans", "Protein", "Salsa", "Toppings", "Sides"];
    const groupArt = {
      Rice: "/ui-assets/group-rice.png",
      Beans: "/ui-assets/group-beans.png",
      Protein: "/ui-assets/group-protein.png",
      Salsa: "/ui-assets/group-salsa.png",
      Toppings: "/ui-assets/group-toppings.png",
      Sides: "/ui-assets/group-sides.png"
    };
    const compactLabels = {
      "white-rice": "White rice",
      "brown-rice": "Brown rice",
      "cauli-rice": "Cauli rice",
      "no-rice": "No rice",
      "black-beans": "Black beans",
      "pinto-beans": "Pinto beans",
      "no-beans": "No beans",
      "no-protein": "No protein",
      "fresh-salsa": "Fresh salsa",
      "corn-salsa": "Corn salsa",
      "green-salsa": "Green salsa",
      "red-salsa": "Red salsa",
      fajita: "Fajita",
      lettuce: "Romaine",
      "sour-cream": "Sour cream",
      guac: "Guacamole",
      "chips-guac": "Chips + guac",
      "side-tortilla": "Tortilla"
    };
    const keys = ["calories", "protein", "carbs", "fat", "sodium", "fiber", "sugar", "saturatedFat"];
    const portions = [
      { label: "L", value: 0.5, title: "Light" },
      { label: "N", value: 1, title: "Normal" },
      { label: "X", value: 1.5, title: "Extra" },
      { label: "2X", value: 2, title: "Double" }
    ];

    let selectedFormat = "bowl";
    let selected = { chicken: 1, "white-rice": 1, "black-beans": 1, "green-salsa": 1, cheese: 1, lettuce: 1 };

    const byId = Object.fromEntries(items.map((item) => [item.id, item]));
    const formatById = Object.fromEntries(formats.map((item) => [item.id, item]));

    function rounded(value) {
      return Math.round(value);
    }

    function formatWholeNumber(value) {
      return Math.round(value).toLocaleString("en-US");
    }

    function formatMacro(value) {
      return `${Math.round(value * 10) / 10}g`;
    }

    function displayName(item) {
      return compactLabels[item.id] || item.name;
    }

    function totalMeal() {
      const base = formatById[selectedFormat];
      const totals = {
        calories: base.calories,
        protein: base.protein,
        carbs: base.carbs,
        fat: base.fat,
        sodium: base.sodium,
        fiber: base.fiber,
        sugar: base.sugar,
        saturatedFat: base.saturatedFat
      };
      Object.entries(selected).forEach(([id, multiplier]) => {
        const item = byId[id];
        if (!item) return;
        keys.forEach((key) => {
          totals[key] += item[key] * multiplier;
        });
      });
      totals.netCarbs = Math.max(0, totals.carbs - totals.fiber);
      return totals;
    }

    function selectedText() {
      const format = formatById[selectedFormat].name;
      const names = Object.entries(selected).map(([id, multiplier]) => {
        const item = byId[id];
        const label = portions.find((portion) => portion.value === multiplier)?.title || `${multiplier}x`;
        return `${item.name} (${label})`;
      });
      return names.length ? `${format}: ${names.join(", ")}` : `${format}: no ingredients selected yet.`;
    }

    function renderFormats() {
      const target = document.querySelector("#format-grid");
      target.innerHTML = formats.map((format) => `
        <button type="button" class="format-button ${format.id === selectedFormat ? "active" : ""}" data-format="${format.id}" aria-pressed="${format.id === selectedFormat}">
          <span class="food-thumb"><img src="${format.image}" alt=""></span>
          <strong>${format.name}</strong>
        </button>
      `).join("");
    }

    function renderIngredients() {
      const target = document.querySelector("#ingredient-groups");
      target.innerHTML = groupOrder.map((group) => {
        const groupItems = items.filter((item) => item.group === group);
        return `
          <section class="ingredient-panel">
            <div class="ingredient-panel-head">
              <h3>${group}</h3>
              <img class="panel-photo" src="${groupArt[group]}" alt="" loading="lazy">
            </div>
            <div class="ingredient-options">
              ${groupItems.map((item) => {
                const multiplier = selected[item.id];
                return `
                  <div class="ingredient-row ${multiplier ? "active" : ""}">
                    <button type="button" class="item-toggle" data-item="${item.id}" aria-pressed="${Boolean(multiplier)}">
                      <span class="item-dot" aria-hidden="true">${item.icon}</span>
                      <span>${displayName(item)}</span>
                      <small>${item.calories} cal</small>
                    </button>
                    <div class="portion-row" aria-label="${item.name} portion">
                      ${portions.map((portion) => `
                        <button type="button" data-portion="${item.id}:${portion.value}" class="${multiplier === portion.value ? "active" : ""}" title="${portion.title} portion">${portion.label}</button>
                      `).join("")}
                    </div>
                  </div>
                `;
              }).join("")}
            </div>
          </section>
        `;
      }).join("");
    }

    function renderPresets() {
      document.querySelector("#preset-list").innerHTML = presets.map((preset, index) => `
        <button type="button" class="preset-button" data-preset="${index}">
          <span class="food-thumb small"><img src="${preset.image}" alt="" loading="lazy"></span>
          <strong>${preset.name}</strong>
          <em>${preset.note}</em>
        </button>
      `).join("");
    }

    function renderReferenceTable() {
      const featured = ["white-rice", "brown-rice", "black-beans", "chicken", "steak", "sofritas", "fresh-salsa", "cheese", "guac", "chips", "side-tortilla"];
      document.querySelector("#reference-table").innerHTML = featured.map((id) => {
        const item = byId[id];
        return `<tr><td>${item.name}</td><td>${item.portion}</td><td>${item.calories}</td><td>${item.protein}g</td><td>${item.carbs}g</td><td>${item.fat}g</td></tr>`;
      }).join("");
    }

    function updateTotals() {
      const totals = totalMeal();
      document.querySelector("#total-calories").textContent = rounded(totals.calories);
      document.querySelector("#dock-calories").textContent = rounded(totals.calories);
      document.querySelector("#total-protein").textContent = formatMacro(totals.protein);
      document.querySelector("#total-carbs").textContent = formatMacro(totals.carbs);
      document.querySelector("#total-fat").textContent = formatMacro(totals.fat);
      document.querySelector("#total-sodium").textContent = `${formatWholeNumber(totals.sodium)}mg`;
      document.querySelector("#total-fiber").textContent = formatMacro(totals.fiber);
      document.querySelector("#total-sugar").textContent = formatMacro(totals.sugar);
      document.querySelector("#total-sat-fat").textContent = formatMacro(totals.saturatedFat);
      const summary = document.querySelector("#selected-summary");
      summary.textContent = window.matchMedia("(max-width: 640px)").matches
        ? `P ${formatMacro(totals.protein)}   C ${formatMacro(totals.carbs)}   F ${formatMacro(totals.fat)}   Sodium ${formatWholeNumber(totals.sodium)}mg`
        : selectedText();
      document.querySelector("#compare-burrito").textContent = selectedFormat === "burrito" ? "included" : "+320 cal";
    }

    function applyPreset(index) {
      const preset = presets[index];
      if (!preset) return;
      selectedFormat = preset.format;
      selected = { ...preset.items };
    }

    function bindEvents() {
      document.querySelectorAll("[data-format]").forEach((button) => {
        button.addEventListener("click", () => {
          selectedFormat = button.dataset.format;
          render();
        });
      });

      document.querySelectorAll("[data-item]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.dataset.item;
          selected[id] ? delete selected[id] : selected[id] = 1;
          render();
        });
      });

      document.querySelectorAll("[data-portion]").forEach((button) => {
        button.addEventListener("click", () => {
          const [id, value] = button.dataset.portion.split(":");
          selected[id] = Number(value);
          render();
        });
      });

      document.querySelectorAll("[data-preset]").forEach((button) => {
        button.addEventListener("click", () => {
          applyPreset(Number(button.dataset.preset));
          render();
        });
      });
    }

    function mealSummary() {
      const totals = totalMeal();
      return `Chipotle-style meal estimate: ${rounded(totals.calories)} calories, ${formatMacro(totals.protein)} protein, ${formatMacro(totals.carbs)} carbs, ${formatMacro(totals.fat)} fat, ${formatWholeNumber(totals.sodium)}mg sodium. ${selectedText()}`;
    }

    async function copySummary(button) {
      const summary = mealSummary();
      try {
        await navigator.clipboard.writeText(summary);
        const original = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => {
          button.textContent = original;
        }, 1400);
      } catch {
        document.querySelector("#selected-summary").textContent = summary;
      }
    }

    async function shareMeal() {
      const text = mealSummary();
      if (navigator.share) {
        try {
          await navigator.share({ title: "Chipotle Nutrition Calculator", text, url: window.location.href });
          return;
        } catch {}
      }
      await copySummary(document.querySelector("#share-meal"));
    }

    function render() {
      renderFormats();
      renderIngredients();
      renderPresets();
      renderReferenceTable();
      bindEvents();
      updateTotals();
    }

    document.querySelector("#clear-all").addEventListener("click", () => {
      selectedFormat = "bowl";
      selected = {};
      render();
    });

    document.querySelector("#dock-copy").addEventListener("click", (event) => copySummary(event.currentTarget));
    document.querySelector("#share-meal").addEventListener("click", shareMeal);
    document.querySelector("#portion-guide").addEventListener("click", () => {
      document.querySelector("#selected-summary").textContent = "Portion guide: L = light half portion, N = normal portion, X = extra 1.5x portion, 2X = double portion.";
    });

    const params = new URLSearchParams(window.location.search);
    if (params.has("preset")) {
      applyPreset(Number(params.get("preset")));
    }

    render();
  </script>
</BaseLayout>
