---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Chipotle Nutrition Calculator: Calories, Macros, Sodium';
const description = 'Build a Chipotle bowl, burrito, salad, tacos, or side order and estimate calories, protein, carbs, fat, sodium, fiber, and sugar with light, extra, and double portions.';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://chipotlenutritioncalculator.app';

const faq = [
  {
    question: 'Is this the official Chipotle nutrition calculator?',
    answer: 'No. This is an independent nutrition estimator that uses published menu nutrition data for planning custom orders.',
  },
  {
    question: 'How accurate are the results?',
    answer: 'The calculator estimates standard published portions. Actual restaurant servings can vary by location, season, recipe update, and how a meal is prepared.',
  },
  {
    question: 'Can I calculate light or extra portions?',
    answer: 'Yes. Selected ingredients can be adjusted to 0.5x, 1x, 1.5x, or 2x so you can model light, normal, extra, and double portions.',
  },
  {
    question: 'What adds the most calories?',
    answer: 'The burrito tortilla, chips, guacamole, queso, cheese, sour cream, and vinaigrette can raise totals quickly.',
  },
  {
    question: 'Does this calculator store my meal?',
    answer: 'No. The calculator runs in your browser and does not require login, upload your order, or store personal meal history.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Chipotle Nutrition Calculator',
    url: siteUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="app-shell">
    <section class="intro-section" aria-labelledby="page-title">
      <div class="intro-copy">
        <p class="eyebrow">Independent meal estimator</p>
        <h1 id="page-title">Chipotle Nutrition Calculator</h1>
        <p class="lede">Build a bowl, burrito, salad, tacos, quesadilla, or side order and estimate calories, macros, sodium, fiber, and sugar before you order.</p>
      </div>
      <div class="source-ticket">
        <span>Data basis</span>
        <strong>Published US menu nutrition</strong>
        <p>Use 0.5x, 1x, 1.5x, and 2x portions to model light, normal, extra, and double servings.</p>
      </div>
    </section>

    <section class="calculator-grid" aria-label="Chipotle nutrition calculator">
      <aside class="totals-panel" aria-live="polite">
        <div class="panel-cap">Meal totals</div>
        <div class="calorie-readout">
          <strong id="total-calories">0</strong>
          <span>calories</span>
        </div>
        <dl class="macro-grid">
          <div><dt>Protein</dt><dd id="total-protein">0g</dd></div>
          <div><dt>Carbs</dt><dd id="total-carbs">0g</dd></div>
          <div><dt>Fat</dt><dd id="total-fat">0g</dd></div>
          <div><dt>Sodium</dt><dd id="total-sodium">0mg</dd></div>
          <div><dt>Fiber</dt><dd id="total-fiber">0g</dd></div>
          <div><dt>Sugar</dt><dd id="total-sugar">0g</dd></div>
          <div><dt>Sat fat</dt><dd id="total-sat-fat">0g</dd></div>
          <div><dt>Net carbs</dt><dd id="total-net-carbs">0g</dd></div>
        </dl>
        <div class="selected-summary" id="selected-summary">Start by choosing a format and ingredients.</div>
        <button type="button" id="copy-summary" class="primary-button">Copy summary</button>
        <button type="button" id="clear-all" class="ghost-button">Clear all</button>
        <p class="privacy-note">Runs locally in your browser. No login or upload.</p>
      </aside>

      <div class="builder-panel">
        <div class="section-head">
          <div>
            <p class="panel-cap">Step 1</p>
            <h2>Choose meal format</h2>
          </div>
        </div>
        <div class="format-grid" id="format-grid"></div>

        <div class="section-head with-note">
          <div>
            <p class="panel-cap">Step 2</p>
            <h2>Add ingredients</h2>
          </div>
          <p>Tap an ingredient, then adjust its portion.</p>
        </div>
        <div class="ingredient-groups" id="ingredient-groups"></div>
      </div>

      <aside class="action-panel">
        <section class="mini-panel">
          <p class="panel-cap">Quick presets</p>
          <div class="preset-list" id="preset-list"></div>
        </section>

        <section class="compare-panel">
          <p class="panel-cap">Compare</p>
          <div class="compare-card">
            <span>Bowl vs burrito</span>
            <strong>+320 cal</strong>
            <p>A flour tortilla also adds about 50g carbs before fillings.</p>
          </div>
          <div class="compare-card">
            <span>Chips add-on</span>
            <strong>+540 cal</strong>
            <p>Chips can add more calories than many complete lean bowls.</p>
          </div>
        </section>
      </aside>
    </section>

    <section class="content-band" aria-labelledby="how-it-works">
      <div class="content-grid">
        <article>
          <p class="panel-cap">Method</p>
          <h2 id="how-it-works">How the calculator works</h2>
          <p>The calculator adds published nutrition values for each selected format, ingredient, side, and drink. Portion buttons multiply each selected item so you can estimate light, normal, extra, or double servings without opening a spreadsheet.</p>
        </article>
        <article>
          <p class="panel-cap">Ordering reality</p>
          <h2>Bowl vs burrito calories</h2>
          <p>A bowl starts with no shell. A burrito starts with the flour tortilla, which adds 320 calories, 50g carbs, and 600mg sodium before rice, beans, protein, salsa, or toppings.</p>
        </article>
        <article>
          <p class="panel-cap">Macro planning</p>
          <h2>High-protein and lower-calorie levers</h2>
          <p>Chicken, steak, beans, fajita vegetables, salsa, and greens are useful planning levers. Cheese, sour cream, queso, guacamole, chips, and vinaigrette are easy to underestimate because they add calories quickly.</p>
        </article>
        <article>
          <p class="panel-cap">Accuracy note</p>
          <h2>Why results are estimates</h2>
          <p>Published nutrition data uses standard portions. Actual servings can vary by store, staff, ingredient source, recipe changes, and whether you ask for light, extra, or double portions.</p>
        </article>
      </div>
    </section>

    <section class="nutrition-table-section" aria-labelledby="ingredient-table-title">
      <div class="section-title-row">
        <div>
          <p class="panel-cap">Reference</p>
          <h2 id="ingredient-table-title">Common ingredient calories</h2>
        </div>
        <p>Use the calculator above for full macros, sodium, fiber, sugar, and portion multipliers.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Portion</th>
              <th>Calories</th>
              <th>Protein</th>
              <th>Carbs</th>
              <th>Fat</th>
            </tr>
          </thead>
          <tbody id="reference-table"></tbody>
        </table>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <p class="panel-cap">FAQ</p>
      <h2 id="faq-title">Chipotle nutrition calculator questions</h2>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <footer class="site-footer">
      <p>This independent tool is not affiliated with Chipotle Mexican Grill, Inc. Nutrition estimates are for planning and general information only, not medical advice.</p>
      <nav aria-label="Footer">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/sitemap.xml">Sitemap</a>
      </nav>
    </footer>
  </main>

  <script is:inline>
    const formats = [
      { id: "bowl", name: "Bowl", note: "No shell", portion: "1 entree", calories: 0, protein: 0, carbs: 0, fat: 0, sodium: 0, fiber: 0, sugar: 0, saturatedFat: 0 },
      { id: "burrito", name: "Burrito", note: "Flour tortilla", portion: "1 tortilla", calories: 320, protein: 8, carbs: 50, fat: 9, sodium: 600, fiber: 3, sugar: 0, saturatedFat: 0.5 },
      { id: "salad", name: "Salad", note: "Supergreens", portion: "1 base", calories: 15, protein: 1, carbs: 3, fat: 0, sodium: 20, fiber: 2, sugar: 1, saturatedFat: 0 },
      { id: "tacos", name: "Tacos", note: "3 crispy shells", portion: "3 shells", calories: 210, protein: 3, carbs: 30, fat: 9, sodium: 0, fiber: 3, sugar: 0, saturatedFat: 0 },
      { id: "quesadilla", name: "Quesadilla", note: "Tortilla + cheese", portion: "1 base", calories: 430, protein: 14, carbs: 51, fat: 17, sodium: 790, fiber: 3, sugar: 1, saturatedFat: 8.5 }
    ];

    const items = [
      { id: "white-rice", group: "Rice and beans", name: "Cilantro-lime white rice", portion: "4 oz", calories: 210, protein: 4, carbs: 40, fat: 4, sodium: 350, fiber: 1, sugar: 0, saturatedFat: 1 },
      { id: "brown-rice", group: "Rice and beans", name: "Cilantro-lime brown rice", portion: "4 oz", calories: 210, protein: 4, carbs: 36, fat: 6, sodium: 190, fiber: 2, sugar: 0, saturatedFat: 0 },
      { id: "black-beans", group: "Rice and beans", name: "Black beans", portion: "4 oz", calories: 130, protein: 8, carbs: 22, fat: 1.5, sodium: 210, fiber: 7, sugar: 2, saturatedFat: 0 },
      { id: "pinto-beans", group: "Rice and beans", name: "Pinto beans", portion: "4 oz", calories: 130, protein: 8, carbs: 21, fat: 1.5, sodium: 210, fiber: 8, sugar: 1, saturatedFat: 0 },
      { id: "fajita", group: "Vegetables", name: "Fajita vegetables", portion: "2 oz", calories: 20, protein: 1, carbs: 5, fat: 0, sodium: 150, fiber: 1, sugar: 2, saturatedFat: 0 },
      { id: "chicken", group: "Protein", name: "Chicken", portion: "4 oz", calories: 180, protein: 32, carbs: 0, fat: 7, sodium: 310, fiber: 0, sugar: 0, saturatedFat: 3 },
      { id: "steak", group: "Protein", name: "Steak", portion: "4 oz", calories: 150, protein: 21, carbs: 1, fat: 6, sodium: 330, fiber: 1, sugar: 0, saturatedFat: 2.5 },
      { id: "barbacoa", group: "Protein", name: "Barbacoa", portion: "4 oz", calories: 170, protein: 24, carbs: 2, fat: 7, sodium: 530, fiber: 1, sugar: 0, saturatedFat: 2.5 },
      { id: "carnitas", group: "Protein", name: "Carnitas", portion: "4 oz", calories: 210, protein: 23, carbs: 0, fat: 12, sodium: 450, fiber: 0, sugar: 0, saturatedFat: 7 },
      { id: "sofritas", group: "Protein", name: "Sofritas", portion: "4 oz", calories: 150, protein: 8, carbs: 9, fat: 10, sodium: 560, fiber: 3, sugar: 5, saturatedFat: 1.5 },
      { id: "fresh-salsa", group: "Salsas", name: "Fresh tomato salsa", portion: "4 oz", calories: 25, protein: 0, carbs: 4, fat: 0, sodium: 550, fiber: 1, sugar: 1, saturatedFat: 0 },
      { id: "corn-salsa", group: "Salsas", name: "Roasted chili-corn salsa", portion: "4 oz", calories: 80, protein: 3, carbs: 16, fat: 1.5, sodium: 330, fiber: 3, sugar: 4, saturatedFat: 0 },
      { id: "green-salsa", group: "Salsas", name: "Tomatillo-green chili salsa", portion: "2 fl oz", calories: 15, protein: 0, carbs: 4, fat: 0, sodium: 260, fiber: 0, sugar: 2, saturatedFat: 0 },
      { id: "red-salsa", group: "Salsas", name: "Tomatillo-red chili salsa", portion: "2 fl oz", calories: 30, protein: 0, carbs: 4, fat: 0, sodium: 500, fiber: 1, sugar: 0, saturatedFat: 0 },
      { id: "sour-cream", group: "Toppings", name: "Sour cream", portion: "2 oz", calories: 110, protein: 2, carbs: 2, fat: 9, sodium: 30, fiber: 0, sugar: 1, saturatedFat: 7 },
      { id: "cheese", group: "Toppings", name: "Cheese", portion: "1 oz", calories: 110, protein: 6, carbs: 1, fat: 8, sodium: 190, fiber: 0, sugar: 0, saturatedFat: 5 },
      { id: "queso", group: "Toppings", name: "Queso blanco", portion: "2 oz", calories: 120, protein: 5, carbs: 4, fat: 9, sodium: 540, fiber: 0, sugar: 2, saturatedFat: 6 },
      { id: "guac", group: "Toppings", name: "Guacamole", portion: "4 oz", calories: 230, protein: 2, carbs: 8, fat: 22, sodium: 370, fiber: 6, sugar: 1, saturatedFat: 3.5 },
      { id: "lettuce", group: "Toppings", name: "Romaine lettuce", portion: "1 oz", calories: 5, protein: 0, carbs: 1, fat: 0, sodium: 0, fiber: 1, sugar: 0, saturatedFat: 0 },
      { id: "vinaigrette", group: "Toppings", name: "Chipotle-honey vinaigrette", portion: "2 fl oz", calories: 220, protein: 1, carbs: 18, fat: 16, sodium: 850, fiber: 1, sugar: 12, saturatedFat: 2.5 },
      { id: "chips", group: "Sides", name: "Chips", portion: "4 oz", calories: 540, protein: 7, carbs: 73, fat: 25, sodium: 390, fiber: 7, sugar: 1, saturatedFat: 3.5 },
      { id: "chips-guac", group: "Sides", name: "Chips and guacamole", portion: "1 order", calories: 770, protein: 9, carbs: 81, fat: 47, sodium: 760, fiber: 13, sugar: 2, saturatedFat: 7 },
      { id: "side-tortilla", group: "Sides", name: "Side tortilla", portion: "1 tortilla", calories: 320, protein: 8, carbs: 50, fat: 9, sodium: 600, fiber: 3, sugar: 0, saturatedFat: 0.5 },
      { id: "apple-juice", group: "Drinks", name: "Apple juice", portion: "6.75 fl oz", calories: 100, protein: 0, carbs: 25, fat: 0, sodium: 15, fiber: 0, sugar: 22, saturatedFat: 0 },
      { id: "iced-tea", group: "Drinks", name: "Iced tea", portion: "22 fl oz", calories: 10, protein: 0, carbs: 3, fat: 0, sodium: 0, fiber: 0, sugar: 0, saturatedFat: 0 }
    ];

    const presets = [
      { name: "Lean Chicken Bowl", note: "High protein, lighter rice", format: "bowl", items: { chicken: 1, "brown-rice": 0.5, "black-beans": 0.5, fajita: 1, "fresh-salsa": 1, lettuce: 1 } },
      { name: "High Protein Double Chicken", note: "More protein, standard carbs", format: "bowl", items: { chicken: 2, "white-rice": 1, "black-beans": 1, fajita: 1, "red-salsa": 1 } },
      { name: "Lower Carb Steak Salad", note: "Greens, steak, guac", format: "salad", items: { steak: 1, fajita: 1, "green-salsa": 1, cheese: 1, guac: 0.5 } },
      { name: "Veggie Bowl", note: "Beans, rice, guac", format: "bowl", items: { "brown-rice": 1, "black-beans": 1, fajita: 1, "corn-salsa": 1, "fresh-salsa": 1, guac: 1 } },
      { name: "Burrito Reality Check", note: "Classic burrito estimate", format: "burrito", items: { chicken: 1, "white-rice": 1, "pinto-beans": 1, cheese: 1, "sour-cream": 1, "fresh-salsa": 1 } },
      { name: "Chips + Guac Add-on", note: "Side-order impact", format: "bowl", items: { chips: 1, guac: 1 } }
    ];

    const keys = ["calories", "protein", "carbs", "fat", "sodium", "fiber", "sugar", "saturatedFat"];
    const portions = [
      { label: "0.5x", value: 0.5, title: "Light" },
      { label: "1x", value: 1, title: "Normal" },
      { label: "1.5x", value: 1.5, title: "Extra" },
      { label: "2x", value: 2, title: "Double" }
    ];

    let selectedFormat = "bowl";
    let selected = {};

    const byId = Object.fromEntries(items.map((item) => [item.id, item]));
    const formatById = Object.fromEntries(formats.map((item) => [item.id, item]));

    function rounded(value) {
      return Math.round(value);
    }

    function formatMacro(value) {
      return `${Math.round(value * 10) / 10}g`;
    }

    function totalMeal() {
      const totals = { ...formatById[selectedFormat] };
      Object.entries(selected).forEach(([id, multiplier]) => {
        const item = byId[id];
        if (!item) return;
        keys.forEach((key) => {
          totals[key] += item[key] * multiplier;
        });
      });
      totals.netCarbs = Math.max(0, totals.carbs - totals.fiber);
      return totals;
    }

    function selectedText() {
      const format = formatById[selectedFormat].name;
      const names = Object.entries(selected).map(([id, multiplier]) => {
        const item = byId[id];
        const label = portions.find((portion) => portion.value === multiplier)?.title || `${multiplier}x`;
        return `${item.name} (${label})`;
      });
      return names.length ? `${format}: ${names.join(", ")}` : `${format}: no ingredients selected yet.`;
    }

    function renderFormats() {
      const target = document.querySelector("#format-grid");
      target.innerHTML = formats.map((format) => `
        <button type="button" class="format-button ${format.id === selectedFormat ? "active" : ""}" data-format="${format.id}" aria-pressed="${format.id === selectedFormat}">
          <strong>${format.name}</strong>
          <span>${format.note}</span>
          <em>${format.calories} cal</em>
        </button>
      `).join("");
    }

    function renderIngredients() {
      const target = document.querySelector("#ingredient-groups");
      const groups = [...new Set(items.map((item) => item.group))];
      target.innerHTML = groups.map((group) => `
        <section class="ingredient-group">
          <h3>${group}</h3>
          <div class="ingredient-list">
            ${items.filter((item) => item.group === group).map((item) => {
              const multiplier = selected[item.id];
              return `
                <div class="ingredient-card ${multiplier ? "active" : ""}">
                  <button type="button" class="item-toggle" data-item="${item.id}" aria-pressed="${Boolean(multiplier)}">
                    <strong>${item.name}</strong>
                    <span>${item.portion} | ${item.calories} cal | ${item.protein}g protein</span>
                  </button>
                  <div class="portion-row" aria-label="${item.name} portion">
                    ${portions.map((portion) => `
                      <button type="button" data-portion="${item.id}:${portion.value}" class="${multiplier === portion.value ? "active" : ""}" title="${portion.title} portion">${portion.label}</button>
                    `).join("")}
                  </div>
                </div>
              `;
            }).join("")}
          </div>
        </section>
      `).join("");
    }

    function renderPresets() {
      document.querySelector("#preset-list").innerHTML = presets.map((preset, index) => `
        <button type="button" class="preset-button" data-preset="${index}">
          <strong>${preset.name}</strong>
          <span>${preset.note}</span>
        </button>
      `).join("");
    }

    function renderReferenceTable() {
      const featured = ["white-rice", "brown-rice", "black-beans", "chicken", "steak", "sofritas", "fresh-salsa", "cheese", "guac", "vinaigrette", "chips", "side-tortilla"];
      document.querySelector("#reference-table").innerHTML = featured.map((id) => {
        const item = byId[id];
        return `<tr><td>${item.name}</td><td>${item.portion}</td><td>${item.calories}</td><td>${item.protein}g</td><td>${item.carbs}g</td><td>${item.fat}g</td></tr>`;
      }).join("");
    }

    function updateTotals() {
      const totals = totalMeal();
      document.querySelector("#total-calories").textContent = rounded(totals.calories);
      document.querySelector("#total-protein").textContent = formatMacro(totals.protein);
      document.querySelector("#total-carbs").textContent = formatMacro(totals.carbs);
      document.querySelector("#total-fat").textContent = formatMacro(totals.fat);
      document.querySelector("#total-sodium").textContent = `${rounded(totals.sodium)}mg`;
      document.querySelector("#total-fiber").textContent = formatMacro(totals.fiber);
      document.querySelector("#total-sugar").textContent = formatMacro(totals.sugar);
      document.querySelector("#total-sat-fat").textContent = formatMacro(totals.saturatedFat);
      document.querySelector("#total-net-carbs").textContent = formatMacro(totals.netCarbs);
      document.querySelector("#selected-summary").textContent = selectedText();
    }

    function applyPreset(index) {
      const preset = presets[index];
      if (!preset) return;
      selectedFormat = preset.format;
      selected = { ...preset.items };
    }

    function bindEvents() {
      document.querySelectorAll("[data-format]").forEach((button) => {
        button.addEventListener("click", () => {
          selectedFormat = button.dataset.format;
          render();
        });
      });

      document.querySelectorAll("[data-item]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.dataset.item;
          selected[id] ? delete selected[id] : selected[id] = 1;
          render();
        });
      });

      document.querySelectorAll("[data-portion]").forEach((button) => {
        button.addEventListener("click", () => {
          const [id, value] = button.dataset.portion.split(":");
          selected[id] = Number(value);
          render();
        });
      });

      document.querySelectorAll("[data-preset]").forEach((button) => {
        button.addEventListener("click", () => {
          applyPreset(Number(button.dataset.preset));
          render();
        });
      });
    }

    function render() {
      renderFormats();
      renderIngredients();
      renderPresets();
      renderReferenceTable();
      bindEvents();
      updateTotals();
    }

    document.querySelector("#clear-all").addEventListener("click", () => {
      selectedFormat = "bowl";
      selected = {};
      render();
    });

    document.querySelector("#copy-summary").addEventListener("click", async () => {
      const totals = totalMeal();
      const summary = `Chipotle meal estimate: ${rounded(totals.calories)} calories, ${formatMacro(totals.protein)} protein, ${formatMacro(totals.carbs)} carbs, ${formatMacro(totals.fat)} fat, ${rounded(totals.sodium)}mg sodium. ${selectedText()}`;
      try {
        await navigator.clipboard.writeText(summary);
        document.querySelector("#copy-summary").textContent = "Copied";
        window.setTimeout(() => {
          document.querySelector("#copy-summary").textContent = "Copy summary";
        }, 1400);
      } catch {
        document.querySelector("#selected-summary").textContent = summary;
      }
    });

    const params = new URLSearchParams(window.location.search);
    if (params.has("preset")) {
      applyPreset(Number(params.get("preset")));
    }

    render();
  </script>
</BaseLayout>
