---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About Typing Test Online';
const description = 'About Typing Test Online, a private browser typing speed test for WPM, CPM, accuracy and recent local results.';
---

<BaseLayout title={title} description={description} canonicalPath="/about/">
  <main class="info-page">
    <a class="back-link" href="/">Back to typing test</a>
    <h1>About Typing Test Online</h1>
    <p class="lead">Typing Test Online is a private browser tool for checking typing speed, character pace, accuracy, errors and recent local progress without creating an account.</p>
    <section>
      <h2>What this tool is for</h2>
      <p>The site is built for quick typing checks and everyday practice. It is useful for warmups, personal benchmarks, keyboard practice and learning how accuracy affects speed.</p>
    </section>
    <section>
      <h2>Privacy approach</h2>
      <p>The core test runs locally. Recent results are saved in browser storage so you can see short term progress without server sync.</p>
    </section>
    <section>
      <h2>No login or uploaded typing input</h2>
      <p>You do not need to sign up, log in, upload a file or create a profile. The text you type into the test area is used by the browser page to calculate your result.</p>
    </section>
    <section>
      <h2>Practice benchmark, not certification</h2>
      <p>Your score is a useful practice benchmark, but it is not an official certificate. Results can vary by keyboard, browser, device, passage difficulty and test duration.</p>
    </section>
  </main>
</BaseLayout>
