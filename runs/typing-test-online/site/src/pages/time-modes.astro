---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Typing Test Time Modes - 15s, 30s, 60s and 120s';
const description = 'Compare typing test time modes and learn when to use 15 second, 30 second, 60 second and 120 second typing tests.';
---

<BaseLayout title={title} description={description} canonicalPath="/time-modes/">
  <main class="info-page">
    <a class="back-link" href="/">Back to typing test</a>
    <h1>Typing Test Time Modes</h1>
    <section>
      <h2>15 seconds</h2>
      <p>Best for warmups and short speed bursts.</p>
    </section>
    <section>
      <h2>30 seconds</h2>
      <p>Good for quick checks while still reducing random spikes.</p>
    </section>
    <section>
      <h2>60 seconds</h2>
      <p>The default mode. It is long enough to balance rhythm, errors and speed.</p>
    </section>
    <section>
      <h2>120 seconds</h2>
      <p>Useful for endurance and real-work typing consistency.</p>
    </section>
  </main>
</BaseLayout>
