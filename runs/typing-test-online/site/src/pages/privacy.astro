---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy - Typing Test Online" description="Privacy policy for Typing Test Online, a static browser-based typing speed test." canonicalPath="/privacy/">
  <main class="text-page">
    <h1>Privacy Policy</h1>
    <p>Typing Test Online is designed to run locally in your browser. The typing test does not require a backend, login system, database, file upload API, or API key.</p>
    <p>If Cloudflare Web Analytics is enabled for production, it may collect privacy-preserving aggregate traffic metrics. The typing text you enter is scored in your browser and is not submitted to this site by the tool.</p>
  </main>
</BaseLayout>
