---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolShell from '../components/ToolShell.astro';
import Faq from '../components/Faq.astro';
import MonetizationSlot from '../components/MonetizationSlot.astro';

const title = 'Example Tool - Free Browser Utility';
const description = 'Use this lightweight browser tool as a starting point for a static SEO-focused tool site.';
const faq = [
  {
    question: 'Is this tool free?',
    answer: 'Yes. This starter is designed for free browser-based tools.',
  },
  {
    question: 'Does it send data to a server?',
    answer: 'No server is included in V1. Tool logic should run locally in the browser.',
  },
];
---
<BaseLayout title={title} description={description}>
  <main class="page-shell">
    <ToolShell title="Example Browser Tool" description="Replace this starter panel with the final tool UI generated by Agent 3 and implemented by Agent 4.">
      <label class="input-label" for="text-input">Paste text</label>
      <textarea id="text-input" rows="8" placeholder="Type or paste something..."></textarea>
      <div class="button-row">
        <button id="analyze-button">Analyze</button>
        <button id="clear-button" class="secondary">Clear</button>
      </div>
      <output id="result" class="result-box">Result will appear here.</output>
    </ToolShell>

    <section class="content-grid">
      <article>
        <h2>How to use this tool</h2>
        <ol>
          <li>Paste or type your input.</li>
          <li>Click the main action button.</li>
          <li>Review the result instantly in your browser.</li>
        </ol>
      </article>
      <article>
        <h2>Built for privacy</h2>
        <p>This starter is designed for local-only browser tools. Do not add network calls unless a future version explicitly requires them.</p>
      </article>
    </section>

    <MonetizationSlot />
    <Faq items={faq} />
  </main>

  <script>
    const input = document.querySelector('#text-input') as HTMLTextAreaElement | null;
    const result = document.querySelector('#result') as HTMLOutputElement | null;
    const analyze = document.querySelector('#analyze-button') as HTMLButtonElement | null;
    const clear = document.querySelector('#clear-button') as HTMLButtonElement | null;

    analyze?.addEventListener('click', () => {
      if (!result) return;
      const value = input?.value || '';
      result.textContent = value.trim()
        ? `Characters: ${value.length}. Words: ${value.trim().split(/\s+/).length}.`
        : 'Please enter some text first.';
    });

    clear?.addEventListener('click', () => {
      if (input) input.value = '';
      if (result) result.textContent = 'Result will appear here.';
    });
  </script>
</BaseLayout>
